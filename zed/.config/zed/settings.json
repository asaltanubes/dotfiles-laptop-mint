// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "vim_mode": true,
  "proxy": "",
  "disable_ai": true,
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "search": {
    "button": true
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true
  },
  "diagnostics": {
    "button": true
  },
  "debugger": {
    "button": true
  },
  "project_panel": {
    "button": true,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "button": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
